---
// One AdSense unit with space reserved up front, so the page doesn't jump when
// the ad loads (layout shift hurts both readers and search ranking).
// Renders nothing until real AdSense IDs are set in .env.
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang; slot?: string }
const { lang, slot } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const ready = client && slot && !client.includes('0000000000') && !/^0+$/.test(slot);
const showPlaceholder = !ready && import.meta.env.DEV;
---
{ready && (
  <aside class="ad-slot" aria-label={t(lang).blog.adLabel}>
    <span>{t(lang).blog.adLabel}</span>
    <ins class="adsbygoogle" style="display:block" data-ad-client={client} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
{showPlaceholder && (
  <aside class="ad-slot" style="border:2px dashed #999;border-radius:12px;align-items:center;justify-content:center;color:#777">
    <span>Ad slot (dev preview, set AdSense IDs in .env)</span>
  </aside>
)}
